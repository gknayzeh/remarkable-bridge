% remarkable-grayscale.latex — Pandoc LaTeX template for rM2 grayscale e-ink
% High contrast black/gray only — no colors
\documentclass[11pt]{article}

% -- Geometry --
\usepackage[margin=2cm]{geometry}

% -- Fonts --
\usepackage[T1]{fontenc}
\usepackage{amssymb}
\usepackage{lmodern}

% -- Colors (grayscale only) --
\usepackage[dvipsnames,svgnames,x11names]{xcolor}
\definecolor{codebg}{HTML}{E8E8E8}
\definecolor{bordercolor}{HTML}{404040}

% -- Code listings --
\usepackage{listings}
\lstset{
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\small,
  breaklines=true,
  frame=single,
  rulecolor=\color{bordercolor},
  keywordstyle=\bfseries,
  stringstyle=\normalfont,
  commentstyle=\itshape,
  showstringspaces=false,
  tabsize=2,
  xleftmargin=4pt,
  xrightmargin=4pt,
  aboveskip=1em,
  belowskip=1em,
}

% -- Highlighting macros (pandoc syntax highlighting — will be black/gray) --
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% -- Hyperlinks --
\usepackage{hyperref}
\hypersetup{
  colorlinks=false,
  pdfborder={0 0 0},
$if(title)$
  pdftitle={$title$},
$endif$
}

% -- Page numbers --
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% -- Headings --
\usepackage{titlesec}
\titleformat{\section}
  {\normalfont\fontsize{18pt}{22pt}\selectfont\bfseries}
  {\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\fontsize{14pt}{18pt}\selectfont\bfseries}
  {\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\fontsize{12pt}{15pt}\selectfont\bfseries}
  {\thesubsubsection}{1em}{}

% -- Blockquotes (redefine quote environment) --
\usepackage{mdframed}
\renewenvironment{quote}{%
  \begin{mdframed}[
    topline=false, rightline=false, bottomline=false,
    linewidth=4pt, linecolor=bordercolor,
    innerleftmargin=10pt, innerrightmargin=10pt,
    innertopmargin=6pt, innerbottommargin=6pt,
    skipabove=\topsep, skipbelow=\topsep
  ]
  \itshape
}{%
  \end{mdframed}
}

% -- Lists --
\usepackage{enumitem}
\setlist{nosep, leftmargin=1.5em}

% -- Paragraph spacing --
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}

% -- Graphics (if needed by pandoc) --
\usepackage{graphicx}
$if(graphics)$
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
$endif$

% -- Tables --
$if(tables)$
\usepackage{longtable,booktabs,array,calc}
$endif$

% -- Tight list support (pandoc) --
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\begin{document}

$if(title)$
\begin{center}
{\fontsize{22pt}{26pt}\selectfont\bfseries $title$}
\end{center}
\vspace{1em}
$endif$

$body$

\end{document}
