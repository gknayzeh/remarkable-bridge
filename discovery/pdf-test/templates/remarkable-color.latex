% remarkable-color.latex — Pandoc LaTeX template for Kaleido 3 color e-ink
% High-saturation colors for washed-out e-ink gamut
\documentclass[11pt]{article}

% -- Geometry --
\usepackage[margin=2cm]{geometry}

% -- Fonts --
\usepackage[T1]{fontenc}
\usepackage{amssymb}
\usepackage{lmodern}

% -- Colors --
\usepackage[dvipsnames,svgnames,x11names]{xcolor}
\definecolor{headingblue}{HTML}{00008B}
\definecolor{codebg}{HTML}{F0F0F0}
\definecolor{kw}{HTML}{0000CC}
\definecolor{str}{HTML}{006600}
\definecolor{cmt}{HTML}{CC3300}
\definecolor{tealbar}{HTML}{006666}

% -- Code listings --
\usepackage{listings}
\lstset{
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\small,
  breaklines=true,
  frame=single,
  rulecolor=\color{gray},
  keywordstyle=\color{kw}\bfseries,
  stringstyle=\color{str},
  commentstyle=\color{cmt}\itshape,
  showstringspaces=false,
  tabsize=2,
  xleftmargin=4pt,
  xrightmargin=4pt,
  aboveskip=1em,
  belowskip=1em,
}

% -- Highlighting macros (pandoc syntax highlighting) --
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% -- Hyperlinks --
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=headingblue,
  urlcolor=headingblue,
  pdfborder={0 0 0},
$if(title)$
  pdftitle={$title$},
$endif$
}

% -- Page numbers --
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% -- Headings --
\usepackage{titlesec}
\titleformat{\section}
  {\normalfont\fontsize{18pt}{22pt}\selectfont\bfseries\color{headingblue}}
  {\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\fontsize{14pt}{18pt}\selectfont\bfseries\color{headingblue}}
  {\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\fontsize{12pt}{15pt}\selectfont\bfseries\color{headingblue}}
  {\thesubsubsection}{1em}{}

% -- Blockquotes (redefine quote environment) --
\usepackage{mdframed}
\renewenvironment{quote}{%
  \begin{mdframed}[
    topline=false, rightline=false, bottomline=false,
    linewidth=3pt, linecolor=tealbar,
    innerleftmargin=10pt, innerrightmargin=10pt,
    innertopmargin=6pt, innerbottommargin=6pt,
    skipabove=\topsep, skipbelow=\topsep
  ]
  \itshape
}{%
  \end{mdframed}
}

% -- Lists --
\usepackage{enumitem}
\setlist{nosep, leftmargin=1.5em}

% -- Paragraph spacing --
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}

% -- Graphics (if needed by pandoc) --
\usepackage{graphicx}
$if(graphics)$
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
$endif$

% -- Tables --
$if(tables)$
\usepackage{longtable,booktabs,array,calc}
$endif$

% -- Tight list support (pandoc) --
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\begin{document}

$if(title)$
\begin{center}
{\fontsize{22pt}{26pt}\selectfont\bfseries\color{headingblue} $title$}
\end{center}
\vspace{1em}
$endif$

$body$

\end{document}
